# ---------------------------------------------------------------------------
# Accountability Partners — environment configuration
# Copy to .env and fill in. Nothing secret is committed.
# ---------------------------------------------------------------------------

# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000
APP_ENV=development                 # development | staging | production

# ---- Database (Postgres) ----
# Local dev or hosted (Neon / Supabase / Vercel Postgres). Must be Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/accountability?schema=public

# ---- Auth ----
# Generate: openssl rand -base64 32
AUTH_SECRET=change-me-dev-secret-change-me-dev-secret

# ---- AI provider (OpenAI-compatible) ----
# REQUIRED for live AI. Without it the app runs in AI_DISABLED fallback mode.
AI_PROVIDER=openai                  # openai | anthropic | mock
AI_API_KEY=
AI_MODEL_FAST=gpt-4o-mini           # low-cost default
AI_MODEL_SMART=gpt-4o               # higher-capability, used sparingly
AI_BASE_URL=https://api.openai.com/v1

# ---- AI cost controls ----
AI_DAILY_REQUESTS_PER_CUSTOMER=40
AI_MONTHLY_REQUESTS_PER_CUSTOMER=600
AI_GLOBAL_DAILY_REQUESTS=5000
AI_KILL_SWITCH=false                # true disables all AI immediately

# ---- Stripe ----
# REQUIRED for live billing. Without it, trials still work; paid conversion is stubbed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=                    # the $35/mo recurring price
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Email (notifications) ----
# Optional. Without it, email notifications are logged, not sent.
EMAIL_PROVIDER=console              # console | resend
EMAIL_API_KEY=
EMAIL_FROM="Accountability Partners <hello@example.com>"

# ---- Jobs / cron ----
# Secret the Vercel Cron / external scheduler must send to run background jobs.
CRON_SECRET=change-me-cron-secret

# ---- Admin ----
# Comma-separated emails granted admin dashboard access.
ADMIN_EMAILS=owner@example.com
